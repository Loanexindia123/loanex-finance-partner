{
  "expo": {
    "name": "LoanEx Super Admin",
    "slug": "lloanex",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2E6F"
      },
      "package": "com.tousifkhansteam.lloanex"
    },
    "owner": "tousif_khan",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LoanEx Super Admin to access your photos for product images."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "ba9658a2-de86-42e0-9e1a-e49abf4c18b6"
      }
    }
  }
}
