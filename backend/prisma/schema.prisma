  mobileNumber                            String?
  house_number                            String?
  apartment                               String?
  street                                  String?
  area                                    String?
  landmark                                String?
  city                                    String?
  state                                   String?
  pincode                                 String?
  is_default                              Boolean?  @default(false)
  isResidentialVerified                   Boolean?  @default(false)
  createdAt                               DateTime? @default(now()) @db.Timestamptz(6)
  userId                                  String?   @db.Uuid
  fullAddress                             String?
