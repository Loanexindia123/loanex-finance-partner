{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,docs/**,node_modules/@prisma/client/**,node_modules/.prisma/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/reminders",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/v1/internal/reminders",
      "schedule": "30 12 * * *"
    }
  ]
}
